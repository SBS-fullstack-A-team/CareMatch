# ==========================================================================
# CareMatch 백엔드 환경변수 예시 (Render 배포 기준)
# 실제 값은 Render 대시보드 > Environment 에 등록. 이 파일은 커밋해도 되는 예시.
# ==========================================================================

# --- 실행 프로필 ---
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# --- DB (벤더 미확정: 아래는 PostgreSQL 예시 플레이스홀더) ---
DB_URL=jdbc:postgresql://HOST:5432/carematch
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_USERNAME=carematch
DB_PASSWORD=change-me
DB_POOL_SIZE=5
JPA_DDL_AUTO=validate

# --- JWT (반드시 64바이트 이상 랜덤 문자열로 교체) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_BYTES
JWT_ACCESS_TTL=1800
JWT_REFRESH_TTL=1209600

# --- CORS (Vercel 배포 도메인. 패턴 매칭 지원 → 프리뷰 배포는 서브도메인 * 로 한 번에 허용) ---
CORS_ALLOWED_ORIGINS=https://carematch.vercel.app,https://carematch-*.vercel.app

# --- 로그인 잠금 정책 ---
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# --- OAuth2 소셜 로그인 ---
OAUTH_REDIRECT_BASE=https://carematch-api.onrender.com
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# 소셜 로그인 성공 후 프론트로 돌려보낼 주소
OAUTH_SUCCESS_REDIRECT=https://carematch.vercel.app/oauth/callback

# --- 파일 스토리지 ---
# STORAGE_PROVIDER=stub : 외부 연동 없이 더미 URL 반환 (로컬/개발 기본)
# STORAGE_PROVIDER=r2   : Cloudflare R2 (S3 호환). 아래 R2_* 세 개가 필요
STORAGE_PROVIDER=stub
STORAGE_BUCKET=carematch-prod
STORAGE_PUBLIC_BASE_URL=https://files.example.invalid
STORAGE_PRESIGN_TTL=600
STORAGE_MAX_UPLOAD_BYTES=5242880
# provider=r2 일 때만. R2 대시보드 > Manage R2 API Tokens > Create Account API token 으로 발급.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- 고객센터 정적 정보 ---
SUPPORT_TEL=1600-0000
SUPPORT_KAKAO_URL=https://pf.kakao.com/_carematch
